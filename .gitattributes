# Normalise to LF in the repository and check out native on Windows. Without
# this, every commit from a Windows machine warns about CRLF conversion and
# diffs between contributors on different platforms show whole files changed.
* text=auto

*.rs      text diff=rust
*.toml    text
*.md      text diff=markdown
*.json    text
*.yml     text
*.yaml    text
*.ts      text
*.tsx     text
*.css     text
*.html    text
*.svg     text

# Batch files are run by cmd.exe, which wants CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
# Shell scripts must keep LF even on Windows or the shebang line breaks.
*.sh      text eol=lf

*.png     binary
*.jpg     binary
*.ico     binary
*.icns    binary
*.exe     binary
*.dll     binary

# Generated; keep it out of diffs and language statistics.
ui/package-lock.json  linguist-generated=true -diff
Cargo.lock            linguist-generated=true -diff

# GitHub counts the repository as Rust, not CSS.
ui/dist/**  linguist-generated=true
